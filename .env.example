# Supabase → Project Settings → API. Son datos públicos (van al navegador).
# Nunca pongas aquí la llave secreta (service_role / secret key).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Meta: completar solo en .env.local (ignorado por Git). Nunca usar NEXT_PUBLIC_.
META_API_KEY=
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai
# Opcional: si se omite, el nivel quick usa META_MODEL.
# META_MODEL_QUICK=muse-spark-1.3
