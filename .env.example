# Archie → Settings → API Keys. Son datos públicos (van al navegador).
# La llave anon debe tener solo el rol Guest, con permisos de lectura (ver docs/archie-setup.md).
# Nunca pongas aquí una llave de administrador.
NEXT_PUBLIC_ARCHIE_PROJECT_ID=a9726866-7936-4111-8505-9093aba8f639
NEXT_PUBLIC_ARCHIE_ENVIRONMENT=master
NEXT_PUBLIC_ARCHIE_API_URL=https://archie-core.services.archie.com
NEXT_PUBLIC_ARCHIE_ANON_KEY=anon ...

# Solo en el servidor (Vercel): ARK IA.
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=60

# ARK Private · API del MLS (RESO Web API / OData). Solo servidor: nunca con NEXT_PUBLIC_.
# Ejemplo de URL base: la que te da tu proveedor (Bridge Interactive, MLS Grid, Trestle...).
# Sin estas dos variables, ARK Private muestra el pulso del MLS con datos demo.
MLS_API_URL=
MLS_API_TOKEN=
