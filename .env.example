# Supabase → Project Settings → API. Son datos públicos (van al navegador).
# Nunca pongas aquí la llave secreta (service_role / secret key).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ARK Private · API del MLS (RESO Web API / OData). Solo servidor: nunca con NEXT_PUBLIC_.
# Ejemplo de URL base: la que te da tu proveedor (Bridge Interactive, MLS Grid, Trestle...).
# Sin estas dos variables, ARK Private muestra el pulso del MLS con datos demo.
MLS_API_URL=
MLS_API_TOKEN=

