# Archie → Settings → API Keys. Son datos públicos (van al navegador).
# La llave anon debe tener solo el rol Guest, con permisos de lectura (ver docs/archie-setup.md).
# Nunca pongas aquí una llave de administrador.
NEXT_PUBLIC_ARCHIE_PROJECT_ID=a9726866-7936-4111-8505-9093aba8f639
NEXT_PUBLIC_ARCHIE_ENVIRONMENT=master
NEXT_PUBLIC_ARCHIE_API_URL=https://archie-core.services.archie.com
NEXT_PUBLIC_ARCHIE_ANON_KEY=anon ...

# Solo en el servidor (Vercel): ARK IA.
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=60

# ARK Video (/video) · leads del evento. Solo servidor.
# GoHighLevel → Automation → Workflows → trigger "Inbound Webhook" → copia la URL aquí.
# Sin esta variable el lead queda guardado en el teléfono del visitante.
GHL_WEBHOOK_URL=

# ARK IA · solo servidor. Claude por defecto; AI_PROVIDER=meta usa Meta (Muse) vía MODEL_API_KEY.
# Si el proveedor elegido no tiene llave, se usa el otro; sin ninguna, ARK Video muestra el plan demo.
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
MODEL_API_KEY=
META_MODEL=muse-wonder-1.0
