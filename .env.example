# Supabase → Project Settings → API. Son datos públicos (van al navegador).
# Nunca pongas aquí la llave secreta (service_role / secret key).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ARK Video (/video) · leads del evento. Solo servidor.
# GoHighLevel → Automation → Workflows → trigger "Inbound Webhook" → copia la URL aquí.
# Sin esta variable el lead queda guardado en el teléfono del visitante.
GHL_WEBHOOK_URL=

# ARK IA · solo servidor. Claude por defecto; AI_PROVIDER=meta usa Meta (Muse) vía MODEL_API_KEY.
# Si el proveedor elegido no tiene llave, se usa el otro; sin ninguna, ARK Video muestra el plan demo.
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
MODEL_API_KEY=
META_MODEL=muse-wonder-1.0
