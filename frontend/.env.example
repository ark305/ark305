# Supabase: Project Settings → API. Estos valores son públicos para el navegador.
# No incluya aquí credenciales administrativas ni claves secretas.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Origen del API HTTP independiente, sin /api/v1. Solo servidor Next.js;
# nunca use el prefijo NEXT_PUBLIC_. El proyecto local hermano es ../ark305-api.
ARK_API_URL=http://127.0.0.1:3001
# Las variables privadas del API se configuran únicamente en su propio repositorio.
